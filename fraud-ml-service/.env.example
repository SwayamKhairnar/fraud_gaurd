# Copy to .env (git-ignored) and adjust. Environment variables override config/settings.yaml.

# --- Server ---
ML_SERVICE_PORT=8000
WEB_CONCURRENCY=1                 # uvicorn worker processes (each loads its own copy of the model)

# --- Model ---
MODEL_DIR=artifacts/models        # folder containing CURRENT and vN/ directories (in Docker: /srv/artifacts/models)
THRESHOLDS_OVERRIDE_PATH=config/thresholds.yaml

# --- Logging and metrics ---
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
METRICS_ENABLED=true

# --- Security (optional, off by default) ---
API_KEY_ENABLED=false
API_KEY=                          # set a long random value if API_KEY_ENABLED=true

# --- Training / data (only used by scripts, not by the service) ---
# KAGGLE_USERNAME=
# KAGGLE_KEY=
